{
  "manifest_version": 3,
  "name": "Resume Application Assistant",
  "version": "4.4",
  "description": "Local resume material library and application tracker. Manual copy only, never auto-submits.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open resume material library",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
